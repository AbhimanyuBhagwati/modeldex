{
  // Modeldex votes. Deploy with `npm run deploy` from this folder; see README.md.
  "name": "modeldex-votes",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "modeldex-votes",
      // From `wrangler d1 create modeldex-votes`. Forking? Create your own and paste its id here.
      "database_id": "0f9afb8e-881f-4f70-a82e-dc6893017b0b"
    }
  ],
  "vars": {
    // Sites allowed to vote. Reads are open to anyone. `*` matches one run of letters, digits, and dashes,
    // so the second Vercel entry covers this project's preview deployments on the `abhi` team only.
    "ALLOWED_ORIGINS": "https://abhimanyubhagwati.github.io,https://modeldex.vercel.app,https://modeldex-*-abhi.vercel.app,http://localhost:3000,http://127.0.0.1:8765"
  },
  // Daily cleanup of vote rows older than a week.
  "triggers": { "crons": ["17 3 * * *"] }
}
